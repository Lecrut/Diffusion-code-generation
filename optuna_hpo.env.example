# Copy to optuna_hpo.env adjust locally.
# The local optuna_hpo.env file is ignored by git.

HPO_STUDY_NAME=diffcoder_pc2_hpo
HPO_STORAGE=sqlite:///optuna_hpo.db
HPO_N_TRIALS=20
HPO_TIMEOUT_SECONDS=0
HPO_TRIAL_TIMEOUT_SECONDS=0
HPO_SEED=42
HPO_TRIALS_DIR=hpo_trials
HPO_DISABLE_COMET=1

# Short trials are enough for comparing settings. Increase after the search narrows.
HPO_MAX_STEPS=3000
HPO_VAL_CHECK_INTERVAL=1000
HPO_LIMIT_VAL_BATCHES=64
HPO_MAX_VAL_SAMPLES=2048
HPO_CHECKPOINT_EVERY_N_STEPS=1000
HPO_CONSOLE_LOG_EVERY_N_BATCHES=500
HPO_SAMPLE_LOG_EVERY_N_STEPS=999999999

# Search space
HPO_BATCH_SIZE_CHOICES=16,24,32,48
HPO_ACCUMULATION_STEPS=1
HPO_HIDDEN_DIM_CHOICES=384,512,640
HPO_NUM_BLOCKS_CHOICES=4,6,8
HPO_DILATION_FACTOR_CHOICES=1,2,3
HPO_BASE_LR_LOW=0.00001
HPO_BASE_LR_HIGH=0.0002
HPO_WEIGHT_DECAY_LOW=0.0001
HPO_WEIGHT_DECAY_HIGH=0.05

# Keep these aligned with normal training unless deliberately testing sequence lengths.
DATASET_FRACTION=1.0
MAX_PROMPT_LEN=96
MAX_CODE_LEN=512
NUM_WORKERS=6
PREFETCH_FACTOR=4
