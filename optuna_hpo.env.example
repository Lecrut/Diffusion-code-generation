# Copy to optuna_hpo.env adjust locally.
# The local optuna_hpo.env file is ignored by git.

HPO_STUDY_NAME=diffcoder_pc2_hpo
HPO_STORAGE=sqlite:///optuna_hpo.db
HPO_N_TRIALS=20
HPO_TIMEOUT_SECONDS=0
HPO_TRIAL_TIMEOUT_SECONDS=0
HPO_SEED=42
HPO_TRIALS_DIR=hpo_trials

# Native Optuna -> Comet logging. Keeps trial params/results in Comet even when
# child training Comet logging is disabled.
HPO_LOG_COMET=1
HPO_COMET_PROJECT_NAME=diffussion-code-generator
HPO_COMET_WORKSPACE=jvsin

# Optional extra per-trial Comet experiment with stdout/stderr/result tails.
# Leave disabled unless the native Optuna integration is not enough.
HPO_LOG_COMET_MANUAL=0
HPO_COMET_LOG_TAIL_CHARS=8000
HPO_DISABLE_COMET=1

# Short trials are enough for comparing settings. Increase after the search narrows.
HPO_MAX_STEPS=3000
HPO_VAL_CHECK_INTERVAL=1000
HPO_LIMIT_VAL_BATCHES=64
HPO_MAX_VAL_SAMPLES=2048
HPO_CHECKPOINT_EVERY_N_STEPS=1000
HPO_CONSOLE_LOG_EVERY_N_BATCHES=500
HPO_SAMPLE_LOG_EVERY_N_STEPS=999999999

# Search space tuned for RTX 3070-class 8 GB cards.
# If you change categorical choices while reusing an existing Optuna DB, either
# keep this unset so the script hashes the choices, or set a new namespace.
HPO_SEARCH_SPACE_NAMESPACE=
HPO_BATCH_SIZE_CHOICES=8,12,16,24
HPO_ACCUMULATION_STEPS=1
HPO_HIDDEN_DIM_CHOICES=256,384,512
HPO_NUM_BLOCKS_CHOICES=4,6
HPO_DILATION_FACTOR_CHOICES=1,2
HPO_BASE_LR_LOW=0.00001
HPO_BASE_LR_HIGH=0.0002
HPO_WEIGHT_DECAY_LOW=0.0001
HPO_WEIGHT_DECAY_HIGH=0.05

# Keep these aligned with normal training unless deliberately testing sequence lengths.
DATASET_FRACTION=1.0
MAX_PROMPT_LEN=96
MAX_CODE_LEN=512
NUM_WORKERS=6
PREFETCH_FACTOR=4
